# 'static' reads the precomputed JSON in public/data (the default).
# 'api' targets a backend — see src/data/datasource/. Not needed for phase 1.
VITE_DATA_SOURCE=static
# VITE_API_BASE_URL=

# Show the five-band maturity labels (Nascent…Optimized) instead of the three
# published bands. Off by default — the three-band model is what produced the
# figures in the assessment report. See build guide §17.2.
VITE_USE_MATURITY_BANDS=false
